(version 1)
(rule "HV pour clearance"
  (constraint clearance (min 2.5mm))
  (condition "A.NetClass == 'HV' && B.Type == 'Zone'"))
(rule "SW pour clearance"
  (constraint clearance (min 1.25mm))
  (condition "A.NetClass == 'SW' && B.Type == 'Zone'"))
(rule "J3 tube header pitch"
  (constraint clearance (min 0.8mm))
  (condition "A.memberOfFootprint('J3') && B.memberOfFootprint('J3')"))
(rule "J1 USB-C pin pitch"
  (constraint clearance (min 0.09mm))
  (condition "A.memberOfFootprint('J1') && B.memberOfFootprint('J1')"))